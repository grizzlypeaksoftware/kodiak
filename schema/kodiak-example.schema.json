{
  "$defs": {
    "ChoiceQuestion": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "choice",
          "default": "choice",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:\\-]+$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "labels": {
          "items": {
            "$ref": "#/$defs/Label"
          },
          "maxItems": 32,
          "minItems": 2,
          "title": "Labels",
          "type": "array"
        },
        "allow_null": {
          "default": true,
          "title": "Allow Null",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "text",
        "labels"
      ],
      "title": "ChoiceQuestion",
      "type": "object"
    },
    "ChoiceTarget": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "probs": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Probs"
        }
      },
      "required": [
        "label"
      ],
      "title": "ChoiceTarget",
      "type": "object"
    },
    "Label": {
      "additionalProperties": false,
      "description": "One option in a choice question. `text` is what the model reads; `id` is what it returns.",
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "Label",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "license": {
          "title": "License",
          "type": "string"
        },
        "split": {
          "enum": [
            "train",
            "val",
            "test"
          ],
          "title": "Split",
          "type": "string"
        },
        "teacher": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Teacher"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "source",
        "license",
        "split"
      ],
      "title": "Meta",
      "type": "object"
    },
    "NullTarget": {
      "additionalProperties": false,
      "properties": {
        "null": {
          "const": true,
          "default": true,
          "title": "Null",
          "type": "boolean"
        }
      },
      "title": "NullTarget",
      "type": "object"
    },
    "ScoreQuestion": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "score",
          "default": "score",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:\\-]+$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "min": {
          "default": 0.0,
          "title": "Min",
          "type": "number"
        },
        "max": {
          "default": 1.0,
          "title": "Max",
          "type": "number"
        },
        "min_label": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Label"
        },
        "max_label": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Label"
        },
        "step": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step"
        },
        "allow_null": {
          "default": true,
          "title": "Allow Null",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "ScoreQuestion",
      "type": "object"
    },
    "ScoreTarget": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value"
      ],
      "title": "ScoreTarget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One training/eval record: a request plus gold answers for every question.",
  "properties": {
    "state": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "items": {},
          "type": "array"
        }
      ],
      "title": "State"
    },
    "questions": {
      "items": {
        "discriminator": {
          "mapping": {
            "choice": "#/$defs/ChoiceQuestion",
            "score": "#/$defs/ScoreQuestion"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/ChoiceQuestion"
          },
          {
            "$ref": "#/$defs/ScoreQuestion"
          }
        ]
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Questions",
      "type": "array"
    },
    "answers": {
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/ChoiceTarget"
          },
          {
            "$ref": "#/$defs/ScoreTarget"
          },
          {
            "$ref": "#/$defs/NullTarget"
          }
        ]
      },
      "title": "Answers",
      "type": "object"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    }
  },
  "required": [
    "state",
    "questions",
    "answers",
    "meta"
  ],
  "title": "Example",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/grizzlypeaksoftware/kodiak/schema/kodiak-example.schema.json"
}
